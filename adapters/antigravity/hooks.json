{
  "cecilia-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|call_mcp_tool|invoke_subagent|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "__CECILIA_GUARD_COMMAND__",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CECILIA_GUARD_COMMAND__",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
