{
  "$description": "Design tokens for <app> — Design Tokens Community Group format. Screens and components use the semantic group only; themes swap the primitives behind them. Owner: cecilia-ui. Values below are placeholders to replace.",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff" },
        "50": { "$type": "color", "$value": "#f7f7f8" },
        "600": { "$type": "color", "$value": "#52525b" },
        "900": { "$type": "color", "$value": "#18181b" }
      },
      "brand": {
        "600": { "$type": "color", "$value": "#1d4ed8" },
        "700": { "$type": "color", "$value": "#1e40af" }
      },
      "red": { "600": { "$type": "color", "$value": "#dc2626" } },
      "green": { "700": { "$type": "color", "$value": "#15803d" } }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "surface": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "subtle": { "$type": "color", "$value": "{primitive.color.neutral.50}" }
      },
      "text": {
        "default": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
        "muted": { "$type": "color", "$value": "{primitive.color.neutral.600}" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "{primitive.color.brand.600}" },
        "primary-hover": { "$type": "color", "$value": "{primitive.color.brand.700}" }
      },
      "status": {
        "danger": { "$type": "color", "$value": "{primitive.color.red.600}" },
        "success": { "$type": "color", "$value": "{primitive.color.green.700}" }
      }
    },
    "space": {
      "inset": {
        "sm": { "$type": "dimension", "$value": "{primitive.space.2}" },
        "md": { "$type": "dimension", "$value": "{primitive.space.4}" }
      },
      "stack": {
        "md": { "$type": "dimension", "$value": "{primitive.space.4}" }
      }
    },
    "radius": {
      "md": { "$type": "dimension", "$value": "8px" }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": { "fontFamily": "<family>", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5 }
      },
      "heading-lg": {
        "$type": "typography",
        "$value": { "fontFamily": "<family>", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.3 }
      }
    },
    "motion": {
      "duration-fast": { "$type": "duration", "$value": "150ms" }
    }
  }
}
