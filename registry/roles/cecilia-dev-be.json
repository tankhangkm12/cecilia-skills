{
  "name": "cecilia-dev-be",
  "agent_type": "writer",
  "kind": "code",
  "description": "Implements backend code as Cecilia's interactive pair programmer. FAST/STANDARD use the task envelope; CONTROLLED requires cecilia-scope. Prepares PR text and the push/PR commands; Cecilia runs them (local-only).",
  "default_on": true,
  "model": "balanced",
  "consumes": [
    "api-contract",
    "module-design",
    "database-doc",
    "plan"
  ],
  "produces": [
    "code",
    "pr-body",
    "report"
  ],
  "lane": [
    "src/**",
    "app/**",
    "server/**",
    "backend/**",
    "services/**",
    "!**/*.test.*"
  ],
  "report": "tensura/reports/<TASK>/dev-be.md",
  "review_guide": [
    "references/review-code.md",
    "references/code-standards.md",
    "references/security/review-code-security.md"
  ],
  "rules_slot": "rules/roles/dev-be.md",
  "lenses": null,
  "overrides": {
    "claude": {
      "tools": null,
      "disallowedTools": null
    },
    "antigravity": {
      "tools": null,
      "extra_tools": [
        "call_mcp_tool"
      ]
    }
  }
}
