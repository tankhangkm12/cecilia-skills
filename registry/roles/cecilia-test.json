{
  "name": "cecilia-test",
  "agent_type": "tester",
  "kind": "code",
  "description": "Tests against requirements and the requested behavior. FAST/STANDARD scale evidence to the task; CONTROLLED uses approved test paths and pinned evidence.",
  "default_on": true,
  "model": "balanced",
  "consumes": [
    "requirements",
    "plan",
    "module-design",
    "api-contract",
    "code"
  ],
  "produces": [
    "tests",
    "test-plan",
    "test-results",
    "bug-reports",
    "report"
  ],
  "lane": [
    "tests/**",
    "test/**",
    "e2e/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "tensura/docs/system/test-plan.md"
  ],
  "report": "tensura/reports/<TASK>/test.md",
  "review_guide": [
    "references/review-tests.md"
  ],
  "rules_slot": "rules/roles/test.md",
  "lenses": "test",
  "overrides": {
    "claude": {
      "tools": null,
      "disallowedTools": null
    },
    "antigravity": {
      "tools": null,
      "extra_tools": [
        "call_mcp_tool"
      ]
    }
  }
}
