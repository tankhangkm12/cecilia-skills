{
  "name": "reviewer",
  "summary": "Independent judgement, one lens per instance. Read-only by construction: no edit, shell, MCP or delegation tools; returns its report as text.",
  "writes": "none",
  "may_dispatch": false,
  "main_thread": false,
  "claude": {
    "tools": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch"
    ],
    "disallowedTools": [
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Bash",
      "Agent",
      "mcp__*"
    ]
  },
  "antigravity": {
    "tools": [
      "view_file",
      "list_dir",
      "find_by_name",
      "grep_search",
      "search_web",
      "read_url_content"
    ],
    "model": "inherit"
  }
}
