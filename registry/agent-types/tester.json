{
  "name": "tester",
  "summary": "Writes and runs tests inside its lane, one lens per instance; several instances may run in parallel. Cannot dispatch other agents.",
  "writes": "lane",
  "may_dispatch": false,
  "main_thread": false,
  "claude": {
    "tools": "inherit",
    "disallowedTools": [
      "Agent"
    ]
  },
  "antigravity": {
    "tools": [
      "view_file",
      "list_dir",
      "find_by_name",
      "grep_search",
      "write_to_file",
      "replace_file_content",
      "multi_replace_file_content",
      "run_command",
      "search_web",
      "read_url_content"
    ],
    "commandExecutionPolicy": "sandbox",
    "model": "inherit"
  }
}
